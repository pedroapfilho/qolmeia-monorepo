# apps/landing: the public marketing site (www.qolmeia.com). Static, so it has
# no auth, no database and no session. It only needs to know where to send
# people to sign in.

# Where the "Entrar" links point. Defaults to https://app.qolmeia.com.
# NEXT_PUBLIC_WEB_APP_URL=https://app.qolmeia.com

# Own public origin, used for metadataBase (OG/social previews).
# Defaults to https://www.qolmeia.com.
# NEXT_PUBLIC_LANDING_URL=https://www.qolmeia.com
