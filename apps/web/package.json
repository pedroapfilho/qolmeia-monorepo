    "@repo/ui": "workspace:*",
    "@repo/worker-api": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.7",
    "ai": "^7.0.83",
    "better-auth": "^1.7.2",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
