# Must match apps/api so cookies signed by the API are valid in this app
# (the proxy uses @repo/auth's getSession to validate the cookie locally).
BETTER_AUTH_SECRET=

# Postgres URL — used by the proxy.ts middleware's Better Auth getSession
# (validates the cookie locally without round-tripping to the auth service).
DATABASE_URL=postgresql://qolmeia:qolmeia123@localhost:5436/qolmeia

# The agents Worker (apps/agents) is SAME-ORIGIN by default: next.config.ts
# rewrites /api/me/*, /api/teams/* and the /agents/* chat WebSocket to it, so
# the session cookie stays first-party (`.localhost` hosts are a public
# suffix — no cookie domain is shareable across portless hosts). Set
# NEXT_PUBLIC_AGENTS_URL only to OVERRIDE with a genuinely cross-origin
# Worker deployment (prod *.workers.dev / custom domain).
# NEXT_PUBLIC_AGENTS_URL=https://worker-bees.qolmeia.workers.dev

# Where the Worker rewrites (and server-side /api/me lookups) proxy to,
# server-to-server.
# AGENTS_INTERNAL_URL=http://127.0.0.1:8787

# Auth is SAME-ORIGIN by default: next.config.ts rewrites /api/auth/* to the
# auth service, so the session cookie stays first-party on this app's origin
# (`.localhost` hosts are a public suffix — no cookie domain is shareable
# across portless hosts). Set NEXT_PUBLIC_AUTH_URL only to OVERRIDE with a
# genuinely cross-origin auth deployment (e.g. prod auth on a sibling
# subdomain that shares a registrable domain for cookies).
# NEXT_PUBLIC_AUTH_URL=https://auth.qolmeia.com

# Where the /api/auth/* rewrite proxies to, server-to-server.
# AUTH_SERVICE_INTERNAL_URL=http://127.0.0.1:4000

# This app's own public origin. Used for metadataBase (OG/social previews),
# defaulting to https://app.qolmeia.com when unset, and it is the only input
# to the proxy.ts Better Auth instance's useSecureCookies — unset, or not
# starting with https://, and the session cookie is issued without the
# Secure flag.
# WEB_APP_URL=https://app.qolmeia.com
