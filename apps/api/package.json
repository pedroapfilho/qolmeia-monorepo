{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "db:seed": "tsx src/scripts/seed-dev.ts",
    "dev": "portless run --name qolmeia.api --app-port 4000 tsdown --watch --on-success \"node --env-file-if-exists=.env dist/index.mjs\"",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hono/zod-openapi": "^1.4.0",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/observability": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.4",
    "@scalar/openapi-to-markdown": "^0.5.26",
    "dotenv": "^17.4.2",
    "hono": "^4.12.26",
    "hono-rate-limiter": "^0.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@types/node": "^25.9.3",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
