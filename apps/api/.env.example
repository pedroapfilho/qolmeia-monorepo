# Database — local docker (docker-compose.yml) for dev; managed URL for prod
DATABASE_URL=postgresql://qolmeia:qolmeia123@localhost:5436/qolmeia

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS (comma-separated allowed origins; defaults to "*" if unset).
# Better Auth requires explicit origins (not "*") for cross-origin cookies, so
# set these to the backoffice + client dev URLs once those apps come online.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (Chat SDK state). Dev = local docker; prod = managed Redis URL.
REDIS_URL=redis://localhost:6382

# Telegram bot — auto-detected by @chat-adapter/telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET_TOKEN=generate-with-openssl-rand-hex-32

# OpenRouter — the only AI key. Covers per-agent text models (Controller =
# openai/gpt-5.3-chat, Marketing Strategist = openai/gpt-5.4-mini, Designer =
# openai/gpt-5.4-nano) AND image generation. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=your-openrouter-key-here

# OpenRouter model id for image generation (Nano Banana Pro by default).
# Exposed so ops can swap the image model without a redeploy — see
# https://openrouter.ai/google for current model ids.
# IMAGE_GEN_MODEL=google/gemini-3-pro-image-preview

# Public-facing app URL — sent as HTTP-Referer to OpenRouter so traffic gets
# attributed to Qolmeia in their dashboard. Falls back to https://qolmeia.ai.
# WEB_APP_URL=https://qolmeia.ai

# Cloudflare R2 (S3-compatible) — brand assets (Phase 3)
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET=your-r2-bucket
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_REGION=auto

# Agent execution mode. "serial" runs the agent loop inline inside the
# webhook handler (default — simpler, single-process). "queue" enqueues
# the agent loop as a BullMQ job and returns the webhook 200 immediately;
# requires `pnpm dev:worker` to be running alongside the API.
DISPATCH_MODE=serial

# Better Auth — required. Generate with `openssl rand -base64 48`.
# Signs cookies and password-reset tokens; rotating invalidates active sessions.
BETTER_AUTH_SECRET=replace-with-32-plus-character-random-secret

# Resend API key. Optional in dev — when absent the auth email hooks become
# no-ops (sendResetPassword, sendVerificationEmail, sendMagicLink succeed
# silently). Required in production so users actually receive emails.
RESEND_API_KEY=

# Default From: address for transactional auth emails. Defaults to
# noreply@qolmeia.ai when unset.
AUTH_FROM_EMAIL=noreply@qolmeia.ai

# Comma-separated extra hosts for Better Auth's dynamic baseURL. Production
# domains + Vercel preview wildcards go here; "**.localhost" + loopback are
# allowed by default.
# AUTH_ALLOWED_HOSTS=qolmeia.ai,*.qolmeia.ai,*.vercel.app

# Comma-separated extra origins for Better Auth's trustedOrigins.
# TRUSTED_ORIGINS=https://app.qolmeia.ai,https://api.qolmeia.ai
