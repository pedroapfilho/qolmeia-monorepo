# apps/api — Better Auth identity service and product provisioning relay.
# Auth and product data share this Postgres database through Prisma.

# Database — local docker (docker-compose.yml) for dev; managed URL for prod
DATABASE_URL=postgresql://qolmeia:qolmeia123@localhost:5436/qolmeia

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS (comma-separated allowed origins; defaults to "*" if unset).
# Dev browser traffic is SAME-ORIGIN: backoffice/client rewrite /api/auth/*
# to this service via their next.config.ts, so the browser never makes a
# cross-origin auth call. This list only matters for direct API callers
# (the e2e suite, curl) and any genuinely cross-origin prod setup.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Better Auth — required. Generate with `openssl rand -base64 48`.
BETTER_AUTH_SECRET=replace-with-32-plus-character-random-secret

# Resend API key. Optional in dev — when absent the auth email hooks become
# no-ops. Required in production so users actually receive emails.
RESEND_API_KEY=

# Default From: address for transactional auth emails. Defaults to
# noreply@email.qolmeia.com when unset.
AUTH_FROM_EMAIL=noreply@email.qolmeia.com

# Comma-separated extra hosts for Better Auth's dynamic baseURL.
# AUTH_ALLOWED_HOSTS=qolmeia.com,*.qolmeia.com,*.vercel.app

# Comma-separated extra origins for Better Auth's trustedOrigins beyond CORS_ORIGINS.
# TRUSTED_ORIGINS=https://app.qolmeia.com,https://api.qolmeia.com

# Shared secret between this service and apps/agents. Required, minimum 32
# characters: this service refuses to boot without it. Both sides must agree
# byte for byte or the calls between them are rejected.
# Generate with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=replace-me-with-at-least-32-characters
