# Must match apps/api so cookies signed by the API are valid in this app
# (the proxy uses @repo/auth's getSession to validate the cookie locally).
BETTER_AUTH_SECRET=

# Public-facing API origin. The client app talks to apps/api at this URL
# for both Better Auth (/api/auth/*) and the web-chat REST + SSE surface.
NEXT_PUBLIC_API_URL=http://localhost:4000
