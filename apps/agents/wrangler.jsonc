{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-bees",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Weekly proactive "suggest next work" sweep (Mondays 13:00 UTC ≈ 10:00 BRT).
  // → src/index.ts scheduled() → runProactiveSweep.
  "triggers": { "crons": ["0 13 * * 1"] },
  "durable_objects": {
    "bindings": [{ "name": "CORRESPONDENT", "class_name": "CorrespondentAgent" }],
  },
  // Single from-scratch migration — no incremental history (local state is
  // rebuilt fresh, nothing in production to preserve).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CorrespondentAgent",
        "FlueCorrespondentAgent",
        "FluePlannerAgent",
        "FlueWorkerAgent",
        "FlueRegistry",
      ],
    },
  ],
  "workflows": [
    {
      "binding": "WORKER_JOB",
      "class_name": "WorkerJobWorkflow",
      "name": "qolmeia-worker-job",
    },
  ],
  "vars": {
    // PLACEHOLDER — replace with your Cloudflare account id (see `wrangler whoami`).
    "AI_GATEWAY_ACCOUNT_ID": "PLACEHOLDER-cloudflare-account-id",
    "AI_GATEWAY_NAME": "qolmeia",
    "CORRESPONDENT_MODEL": "openai/gpt-5.3-chat",
    // Image generation model — hot-swappable without a deploy. Default is
    // Nano Banana 2 (gemini-3.1-flash-image-preview), Google's latest as of
    // Feb 2026 — Pro-tier quality at Flash speed. Alternates verified live
    // on OpenRouter: google/gemini-3-pro-image-preview (Nano Banana Pro,
    // highest fidelity, slower/pricier), google/gemini-2.5-flash-image
    // (original Nano Banana). All route through /chat/completions with
    // modalities: ["image","text"].
    "IMAGE_GEN_MODEL": "google/gemini-3.1-flash-image-preview",
    // Public URL of this Worker — used to build absolute asset URLs the client
    // can fetch. Override at deploy with the *.workers.dev / custom domain URL.
    "WORKER_PUBLIC_URL": "http://localhost:8787",
    // Better Auth service (apps/api); the Worker validates sessions against it.
    "AUTH_SERVICE_URL": "http://localhost:4000",
    // Comma-separated client origins allowed to call the Worker. The
    // customer app runs on :3001 and the operator backoffice on :3000.
    "CLIENT_ORIGINS": "http://localhost:3000,http://localhost:3001",
  },
  // INTERNAL_SHARED_SECRET is a Worker secret (wrangler secret put) — used
  // to gate /api/internal/* against apps/api's org-create relay. Defined
  // as a placeholder var here so local dev (which reads .dev.vars) just
  // works; production sets it via `wrangler secret put`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worker-bees",
      // PLACEHOLDER — replace with the id printed by `wrangler d1 create worker-bees`.
      // Local dev and vitest-pool-workers ignore this value; remote deploy needs the real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      // Miniflare emulates R2 locally; deploy creates the real bucket via
      // `wrangler r2 bucket create qolmeia-assets`.
      "bucket_name": "qolmeia-assets",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CONNECTOR_SECRETS",
      // Miniflare emulates KV locally; deploy provisions the real namespace
      // via `wrangler kv namespace create qolmeia-connector-secrets`.
      "id": "PLACEHOLDER-connector-secrets-namespace-id",
    },
    {
      "binding": "SESSIONS",
      // 30s session cache for validateSession — keeps the auth service off
      // the hot path of every backoffice render + every chat WS upgrade.
      // Deploy: `wrangler kv namespace create qolmeia-sessions`.
      "id": "PLACEHOLDER-sessions-namespace-id",
    },
  ],
  // ── PROD-ONLY (uncomment + provision at deploy; see docs/deploy.md) ─────────
  // These stay commented so local `wrangler dev` and a pre-provisioning
  // `wrangler deploy` don't fail on resources/zones that don't exist yet.
  //
  // Custom domain — the Worker's public origin (agents.qolmeia.com). Requires the
  // qolmeia.com zone to be active on this Cloudflare account. Also set
  // WORKER_PUBLIC_URL=https://agents.qolmeia.com in `vars` above.
  // "routes": [{ "pattern": "agents.qolmeia.com", "custom_domain": true }],
  //
  // Agent Memory backend (ADR 0007): Workers AI for embeddings + Vectorize for
  // recall. Without these, the memory adapter falls back to an in-process store
  // that's lost on DO eviction. Provision:
  //   wrangler vectorize create qolmeia-memory --dimensions=1024 --metric=cosine
  // "ai": { "binding": "AI" },
  // "vectorize": [{ "binding": "VECTORIZE", "index_name": "qolmeia-memory" }],
}
