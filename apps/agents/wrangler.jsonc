{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qolmeia-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "CORRESPONDENT", "class_name": "CorrespondentAgent" },
      { "name": "WORKER_AGENT", "class_name": "WorkerAgent" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CorrespondentAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["WorkerAgent"] },
  ],
  "workflows": [
    {
      "binding": "WORKER_JOB",
      "class_name": "WorkerJobWorkflow",
      "name": "qolmeia-worker-job",
    },
  ],
  "vars": {
    // PLACEHOLDER — replace with your Cloudflare account id (see `wrangler whoami`).
    "AI_GATEWAY_ACCOUNT_ID": "PLACEHOLDER-cloudflare-account-id",
    "AI_GATEWAY_NAME": "qolmeia",
    "CORRESPONDENT_MODEL": "openai/gpt-5.3-chat",
    // Image generation model — hot-swappable without a deploy.
    "IMAGE_GEN_MODEL": "google/gemini-3-pro-image-preview",
    // Public URL of this Worker — used to build absolute asset URLs the client
    // can fetch. Override at deploy with the *.workers.dev / custom domain URL.
    "WORKER_PUBLIC_URL": "http://localhost:8787",
    // The existing Better Auth service (apps/api); the Worker validates sessions against it.
    "AUTH_SERVICE_URL": "http://localhost:4000",
    // Comma-separated client origins allowed to call the Worker.
    "CLIENT_ORIGINS": "http://localhost:3001",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qolmeia-agents",
      // PLACEHOLDER — replace with the id printed by `wrangler d1 create qolmeia-agents`.
      // Local dev and vitest-pool-workers ignore this value; remote deploy needs the real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      // Miniflare emulates R2 locally; deploy creates the real bucket via
      // `wrangler r2 bucket create qolmeia-assets`.
      "bucket_name": "qolmeia-assets",
    },
  ],
}
