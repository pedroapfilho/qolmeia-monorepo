{
  "name": "worker-bees",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "cf-typegen": "wrangler types",
    "clean": "rm -rf .turbo node_modules .wrangler",
    "deploy": "flue build --target cloudflare && wrangler deploy --config dist/worker_bees/wrangler.json",
    "dev": "flue dev --target cloudflare --port 8787",
    "lint": "oxlint src",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@flue/runtime": "1.0.0-beta.9",
    "agents": "^0.17.3",
    "ai": "^7.0.14",
    "hono": "^4.12.27",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@flue/cli": "1.0.0-beta.9",
    "@repo/typescript-config": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
