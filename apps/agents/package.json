{
  "name": "worker-bees",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf .turbo node_modules .wrangler .flue-vite .flue-vite.wrangler.jsonc",
    "deploy": "vite build && wrangler deploy",
    "dev": "vite dev",
    "lint": "oxlint src",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.28",
    "@flue/runtime": "2.0.3",
    "@repo/worker-api": "workspace:*",
    "agents": "^0.20.1",
    "ai": "^7.0.58",
    "hono": "^4.13.1",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@flue/vite": "2.0.3",
    "@repo/typescript-config": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0",
    "zod-compiler": "^1.27.0"
  }
}
