# Public — embedded in client bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side Better Auth secret. MUST match the value in apps/api/.env so
# the cookie issued by the API validates here. Generate with
# `openssl rand -base64 48`.
BETTER_AUTH_SECRET=replace-with-32-plus-character-random-secret

# Optional: used in metadataBase for OG/social previews.
# WEB_APP_URL=https://app.qolmeia.ai
