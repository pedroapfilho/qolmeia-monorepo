{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "API_INTERNAL_URL",
        "AUTH_ALLOWED_HOSTS",
        "AUTH_SERVICE_INTERNAL_URL",
        "AUTH_FROM_EMAIL",
        "BETTER_AUTH_SECRET",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "INTERNAL_SHARED_SECRET",
        "NEXT_PUBLIC_AGENTS_URL",
        "NEXT_PUBLIC_AUTH_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_LANDING_URL",
        "NEXT_PUBLIC_WEB_APP_URL",
        "RESEND_API_KEY",
        "TRUSTED_ORIGINS",
        "WEB_APP_URL"
      ]
    },
    "lint": { "dependsOn": ["^build", "db:generate"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build", "db:generate"] },
    "format:check": { "cache": false },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "deploy": { "dependsOn": ["^build"], "cache": false },
    "start": { "dependsOn": ["^build"], "cache": false },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "clean": { "cache": false },
    "db:generate": { "cache": false, "env": ["DATABASE_URL"] },
    "db:push": { "cache": false, "env": ["DATABASE_URL"] },
    "db:seed": { "cache": false, "env": ["DATABASE_URL"] }
  }
}
