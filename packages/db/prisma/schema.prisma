datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

generator workerClient {
  provider = "prisma-client"
  output   = "../src/generated/prisma-worker"
  runtime  = "cloudflare"
}

// Better Auth and product data share Postgres. The agents Worker connects to
// this schema through Prisma's Cloudflare-compatible PostgreSQL adapter.

enum OrgRole {
  OWNER
  STAFF
  CUSTOMER
}

// Closed sets the application already enumerates in TypeScript. They were bare
// String columns read through a coercion that silently rewrote any unrecognised
// value to a default, so a bad write surfaced as a valid-looking wrong state
// (an `executed` action reappearing as `pending`, an asset defaulting to
// customer-visible). Columns that operators genuinely extend at runtime
// (worker_kind, action_type, activity_log.type, ticket.origin, memory_fact.kind)
// stay String on purpose.

enum CompanyStatus {
  onboarding
  active
  paused
}

enum TemplateStatus {
  active
  retired
}

enum AgentRole {
  correspondent
  planner
  worker
}

enum AgentInstanceStatus {
  active
  paused
}

enum TicketStatus {
  open
  in_progress
  awaiting_approval
  blocked
  done
  cancelled
  rejected
}

enum ActionStatus {
  pending
  approved
  changes_requested
  rejected
  executed
}

enum ActionPolicy {
  auto_execute
  notify_only
  require_approval
}

enum AssetKind {
  audio
  brand_asset
  generated_image
  knowledge_doc
  user_upload
}

enum AssetVisibility {
  agent
  customer
}

enum OperatorAssignmentKind {
  company
  discipline
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Sao_Paulo")
  currency  String   @default("BRL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrgMembership[]

  @@index([slug])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   Boolean  @default(false)
  name            String
  image           String?
  username        String?  @unique
  displayUsername String?
  displayName     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships OrgMembership[]

  @@index([email])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  // Set by Better Auth's admin/impersonation flows. Kept nullable so the
  // column round-trips even when impersonation is disabled.
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  issuer                String    @default("local:credential")
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth database-backed rate limiting, required because the auth
// config sets `rateLimit.storage: "database"`. Rows are written on first
// limited request.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Per-user membership in an Organization. A user can belong to many orgs and
// holds one role per org. (userId, orgId) is unique. role drives the
// backoffice / client permission split (OWNER + STAFF see the backoffice;
// CUSTOMER uses the client app).
model OrgMembership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, orgId])
  @@index([orgId, role])
}

model Company {
  id        String        @id
  name      String
  slug      String        @unique
  timezone  String        @default("America/Sao_Paulo")
  locale    String        @default("pt-BR")
  status    CompanyStatus @default(onboarding)
  brief     Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  actions              Action[]
  activityLogs         ActivityLog[]
  agentInstances       AgentInstance[]
  assets               Asset[]
  memoryFacts          MemoryFact[]
  team                 Team?
  templateEntitlements CompanyTemplateEntitlement[]
  tickets              Ticket[]

  @@index([status])
  @@map("company")
}

model AgentTemplate {
  id                String         @id
  workerKind        String         @map("worker_kind")
  displayName       String         @map("display_name")
  description       String
  systemPrompt      String         @map("system_prompt") @db.Text
  model             String
  skillIds          Json           @map("skill_ids")
  defaultPolicies   Json           @map("default_policies")
  status            TemplateStatus @default(active)
  version           Int            @default(1)
  defaultActionType String         @default("worker_deliverable") @map("default_action_type")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  agentInstances AgentInstance[]
  entitlements   CompanyTemplateEntitlement[]

  @@index([status, workerKind])
  @@map("template")
}

model Skill {
  id            String   @id
  displayName   String   @map("display_name")
  description   String
  paramHints    Json?    @map("param_hints")
  defaultConfig Json?    @map("default_config")
  enabled       Boolean  @default(true)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("skill")
}

model CompanyTemplateEntitlement {
  companyId  String        @map("company_id")
  templateId String        @map("template_id")
  enabled    Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template   AgentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([companyId, templateId])
  @@index([companyId, enabled])
  @@map("company_template_entitlement")
}

model AgentInstance {
  id              String              @id
  companyId       String              @map("company_id")
  role            AgentRole
  templateId      String?             @map("template_id")
  templateVersion Int?                @map("template_version")
  displayName     String              @map("display_name")
  modelOverride   String?             @map("model_override")
  status          AgentInstanceStatus @default(active)
  promptOverride  String?             @map("prompt_override") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template        AgentTemplate?      @relation(fields: [templateId], references: [id], onDelete: Restrict)

  memoryFacts MemoryFact[]
  memberships TeamMember[]
  tickets     Ticket[]

  @@index([companyId, role, status])
  @@map("agent_instance")
}

model Team {
  id          String       @id
  companyId   String       @unique @map("company_id")
  confirmedAt DateTime?    @map("confirmed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     TeamMember[]

  @@map("team")
}

model TeamMember {
  teamId          String        @map("team_id")
  agentInstanceId String        @map("agent_instance_id")
  canDelegateTo   Json          @default("[]") @map("can_delegate_to")
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)

  @@id([teamId, agentInstanceId])
  @@index([agentInstanceId])
  @@map("team_member")
}

model Ticket {
  id              String        @id
  companyId       String        @map("company_id")
  agentInstanceId String        @map("agent_instance_id")
  parentTicketId  String?       @map("parent_ticket_id")
  title           String
  brief           String        @db.Text
  status          TicketStatus  @default(open)
  origin          String
  workflowId      String?       @map("workflow_id")
  result          Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Restrict)
  parentTicket    Ticket?       @relation("TicketTree", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets    Ticket[]      @relation("TicketTree")
  actions         Action[]

  @@index([companyId, agentInstanceId, status])
  @@map("ticket")
}

model Action {
  id              String       @id
  ticketId        String       @map("ticket_id")
  companyId       String       @map("company_id")
  actionType      String       @map("action_type")
  policy          ActionPolicy
  proposed        Json
  status          ActionStatus @default(pending)
  decidedByUserId String?      @map("decided_by_user_id")
  decidedAt       DateTime?    @map("decided_at")
  feedback        String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  ticket          Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([ticketId, status])
  @@map("action")
}

model ActivityLog {
  id        String   @id
  companyId String   @map("company_id")
  type      String
  refType   String?  @map("ref_type")
  refId     String?  @map("ref_id")
  summary   String
  payload   Json?
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("activity_log")
}

model MemoryFact {
  id              String        @id
  companyId       String        @map("company_id")
  agentInstanceId String        @map("agent_instance_id")
  kind            String
  content         String        @db.Text
  salience        Float         @default(0.5)
  createdAt       DateTime      @default(now()) @map("created_at")
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)

  @@index([agentInstanceId, createdAt])
  @@map("memory_fact")
}

model OperatorAssignment {
  id             String                 @id
  operatorUserId String                 @map("operator_user_id")
  kind           OperatorAssignmentKind
  value          String
  createdAt      DateTime               @default(now()) @map("created_at")

  @@unique([operatorUserId, kind, value])
  @@index([operatorUserId])
  @@map("operator_assignment")
}

model Asset {
  id         String          @id
  companyId  String          @map("company_id")
  kind       AssetKind
  r2Key      String          @map("r2_key")
  sha256     String
  mime       String
  bytes      Int
  metadata   Json?
  createdAt  DateTime        @default(now()) @map("created_at")
  visibility AssetVisibility @default(customer)
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sha256])
  @@index([companyId, kind, createdAt])
  @@map("asset")
}
