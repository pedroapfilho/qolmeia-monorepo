datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Channel {
  WEB_CHAT
  TELEGRAM
}

enum ConversationStatus {
  ACTIVE
  RESOLVED
  ARCHIVED
}

enum MessageSender {
  CUSTOMER
  AGENT
  SYSTEM
}

enum ContentType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
}

enum AgentInstanceStatus {
  ACTIVE
  PAUSED
}

enum ConnectorType {
  TELEGRAM
  WHATSAPP
  FRESHA
  GOOGLE_MY_BUSINESS
  INSTAGRAM
}

enum SenderRole {
  OWNER
  CUSTOMER
}

enum BindingDirection {
  INBOUND
  OUTBOUND
  BOTH
}

enum AgentActionStatus {
  DRAFTED
  AUTO_APPROVED
  APPROVED
  REJECTED
  EDITED
  EXPIRED
  FAILED
  EXECUTED
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum KnowledgeDocContentType {
  MARKDOWN
  PLAIN_TEXT
  JSON
}

// Unified, append-only timeline of business-level events for an org.
// Read by the future web UI to render the full sequence (DM → run start →
// tool calls → run finish → reply). Each row is one discrete event.
// Multica-style — see docs/research/2026-05-20-paperclip-and-multica.md §5.3.
enum ActivityLogType {
  MESSAGE_INBOUND
  MESSAGE_OUTBOUND
  AGENT_RUN_STARTED
  AGENT_RUN_FINISHED
  AGENT_RUN_FAILED
  ACTION_EXECUTED
  ACTION_FAILED
  ACTION_DRAFTED
  ACTION_APPROVED
  ACTION_REJECTED
  BUDGET_WARN_80
  BUDGET_WARN_100
  INSTRUCTIONS_UPDATED
  BUSINESS_IDEA_UPDATED
  OWNER_COMMAND
}

// Identifies which entity the refId points at. NONE for free-floating events
// (rare; mostly reserved for future system-level entries).
enum ActivityLogRefType {
  MESSAGE
  AGENT_RUN
  AGENT_ACTION
  ORGANIZATION
  NONE
}

model AgentTemplate {
  slug                             String          @id
  displayName                      String
  description                      String          @db.Text
  defaultSystemPrompt              String          @db.Text
  defaultMission                   String          @db.Text
  compatibleInboundConnectorTypes  ConnectorType[]
  compatibleOutboundConnectorTypes ConnectorType[]
  canDelegateTo                    String[]
  defaultBudgetCents               Int             @default(0)
  skills                           Skill[]         @relation("TemplateSkills")
  instances                        AgentInstance[]
  createdAt                        DateTime        @default(now())
  updatedAt                        DateTime        @updatedAt
}

model Skill {
  id                      String                 @id
  displayName             String
  description             String                 @db.Text
  parametersJsonSchema    Json
  requiresApprovalDefault Boolean                @default(false)
  requiredConnectorTypes  ConnectorType[]
  templates               AgentTemplate[]        @relation("TemplateSkills")
  agentActions            AgentAction[]
  enablements             AgentSkillEnablement[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

model ConnectorInstance {
  id            String                  @id @default(cuid())
  orgId         String
  type          ConnectorType
  displayName   String
  config        Json
  capabilities  Json
  senderRole    SenderRole
  org           Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bindings      AgentConnectorBinding[]
  conversations Conversation[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([orgId, type])
}

model AgentInstance {
  id              String                  @id @default(cuid())
  orgId           String
  templateSlug    String
  displayName     String
  mission         String                  @db.Text
  // Enabled skills are tracked in AgentSkillEnablement (Phase 5a, Group 2.3).
  // Zero rows ⇒ runtime falls back to the template's defaultEnabledSkillIds.
  budgetCents     Int                     @default(0)
  status          AgentInstanceStatus     @default(ACTIVE)
  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template        AgentTemplate           @relation(fields: [templateSlug], references: [slug])
  bindings        AgentConnectorBinding[]
  actions         AgentAction[]
  enablements     AgentSkillEnablement[]
  runs            AgentRun[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([orgId, templateSlug])
  @@index([orgId])
}

// Join table connecting AgentInstance ↔ Skill with per-instance enablement
// metadata. Replaces the legacy AgentInstance.enabledSkillIds Json array.
// Semantics: zero rows for an instance ⇒ fall back to the template's
// defaultEnabledSkillIds (the null case). One or more rows ⇒ explicit skill
// set (including the explicit-empty case once we expose UI to remove rows).
model AgentSkillEnablement {
  id              String        @id @default(cuid())
  agentInstanceId String
  skillId         String
  enabledAt       DateTime      @default(now())
  // User who enabled the skill. Nullable for system/migration enablements
  // and because we don't have users yet.
  enabledBy       String?
  // Per-instance overrides for the skill's parameters / defaults. Null = use
  // the skill's own defaults.
  configOverride  Json?
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id])

  @@unique([agentInstanceId, skillId])
  @@index([agentInstanceId])
}

model AgentConnectorBinding {
  id                  String            @id @default(cuid())
  agentInstanceId     String
  connectorInstanceId String
  direction           BindingDirection
  agentInstance       AgentInstance     @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  connectorInstance   ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([agentInstanceId, connectorInstanceId, direction])
  @@index([connectorInstanceId, direction])
}

model AgentAction {
  id               String            @id @default(cuid())
  agentInstanceId  String
  skillId          String
  // Parent AgentRun this action belongs to. Nullable for backward compat
  // with pre-Group-3.1 rows; new runs always set it. Group 3.x will tighten
  // to non-null once backfill is in place. Pedro's local data has no rows
  // worth migrating, so no one-shot script is needed.
  runId            String?
  triggerMessageId String?
  parentActionId   String?
  proposedInput    Json
  proposedSummary  String            @db.Text
  status           AgentActionStatus @default(DRAFTED)
  decidedByUserId  String?
  decidedAt        DateTime?
  executedAt       DateTime?
  resultJson       Json?
  errorMessage     String?           @db.Text
  costCents        Int               @default(0)
  costCurrency     String            @default("BRL")
  costInputTokens  Int               @default(0)
  costOutputTokens Int               @default(0)
  agentInstance    AgentInstance     @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  skill            Skill             @relation(fields: [skillId], references: [id])
  agentRun         AgentRun?         @relation(fields: [runId], references: [id], onDelete: Cascade)
  parent           AgentAction?      @relation("ChildActions", fields: [parentActionId], references: [id])
  children         AgentAction[]     @relation("ChildActions")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([agentInstanceId, status, createdAt])
  @@index([triggerMessageId])
  @@index([parentActionId])
  @@index([runId])
}

// Parent record for "one agent invocation". A single inbound message can
// fan out into Controller → Strategist → Designer runs; each is its own
// AgentRun row, linked via parentRunId. Holds the deterministic context
// snapshot assembled at dispatch time so re-runs replay against the same
// inputs (Multica-style — see docs/research/2026-05-20-paperclip-and-multica.md §5.3).
model AgentRun {
  id                String         @id @default(cuid())
  agentInstanceId   String
  // Links to Message for top-level inbound runs. Null for delegation
  // children (the trigger lives one hop up via parentRunId) and future
  // manual/scheduled runs.
  triggerMessageId  String?
  // Self-FK for the delegation chain. Null when this run is the root.
  parentRunId       String?
  // Serialized business context + assets + mission as of dispatch time.
  // Read by the runtime via this column — runtime never re-reads the soul.
  contextSnapshot   Json
  // Fully rendered system prompt for this run. Stored so we can replay the
  // exact prompt the model saw, even if the template definition drifts.
  systemPrompt      String         @db.Text
  status            AgentRunStatus @default(RUNNING)
  costCents         Int            @default(0)
  costInputTokens   Int            @default(0)
  costOutputTokens  Int            @default(0)
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?
  errorMessage      String?        @db.Text
  agentInstance     AgentInstance  @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  triggerMessage    Message?       @relation(fields: [triggerMessageId], references: [id])
  parentRun         AgentRun?      @relation("ChildRuns", fields: [parentRunId], references: [id])
  childRuns         AgentRun[]     @relation("ChildRuns")
  actions           AgentAction[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([agentInstanceId, startedAt])
  @@index([triggerMessageId])
  @@index([parentRunId])
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  timezone        String   @default("America/Sao_Paulo")
  currency        String   @default("BRL")
  // The "soul" — accessed ONLY via KnowledgeProvider.getBusinessContext().
  businessProfile Json?
  // Owner-curated free-form instructions read by every agent. Owner-only;
  // never written by skills (Paperclip plugin-llm-wiki AGENTS.md equivalent).
  agentInstructions String? @db.Text
  // Owner-curated business direction. Read by every agent; complements (does
  // not replace) the AI-managed businessProfile (Paperclip IDEA.md equivalent).
  businessIdea      String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  telegramLink       TelegramLink?
  customers          Customer[]
  conversations      Conversation[]
  brandAssets        BrandAsset[]
  connectorInstances ConnectorInstance[]
  agentInstances     AgentInstance[]
  knowledgeDocs      KnowledgeDoc[]
  activityLogs       ActivityLog[]

  @@index([slug])
}

model TelegramLink {
  id             String       @id @default(cuid())
  telegramChatId String       @unique
  orgId          String       @unique
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Customer {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phone     String?
  email     String?
  name      String?
  meta      Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  conversations Conversation[]

  @@unique([orgId, phone])
  @@unique([orgId, email])
  @@index([orgId])
}

model Conversation {
  id                  String             @id @default(cuid())
  channel             Channel            @default(TELEGRAM)
  externalId          String?
  status              ConversationStatus @default(ACTIVE)
  orgId               String
  org                 Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId          String?
  customer            Customer?          @relation(fields: [customerId], references: [id])
  connectorInstanceId String?
  connectorInstance   ConnectorInstance? @relation(fields: [connectorInstanceId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  messages Message[]

  @@index([orgId, status])
  @@index([connectorInstanceId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?
  sender         MessageSender
  content        String
  contentType    ContentType   @default(TEXT)
  metadata       Json?
  agentRuns      AgentRun[]
  createdAt      DateTime      @default(now())

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String
  payload    Json
  status     String   @default("processed")
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
}

model BrandAsset {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  r2Key     String
  sha256    String
  mimeType  String
  size      Int
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, sha256])
  @@index([orgId, createdAt])
}

model KnowledgeDoc {
  id          String                  @id @default(cuid())
  orgId       String
  r2Key       String
  title       String
  summary     String                  @db.Text
  tags        String[]
  contentType KnowledgeDocContentType @default(MARKDOWN)
  size        Int
  org         Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId])
}

// Append-only, per-org timeline of business-level events. Writes are funnelled
// through activity/log.ts so the call sites stay thin and future fan-out (a
// Streams bus, webhooks) only needs to plug into one place. Never updated;
// rows are immutable history.
model ActivityLog {
  id        String             @id @default(cuid())
  orgId     String
  type      ActivityLogType
  refType   ActivityLogRefType
  // Foreign id of the entity this event refers to. Not a typed FK — we want
  // a single column that can point at Message, AgentRun, AgentAction, etc.
  // and survive cascade deletes of those rows (the history persists even if
  // the underlying entity is later removed).
  refId     String?
  // Human-readable one-liner in pt-BR. Rendered as-is by the UI.
  summary   String             @db.Text
  // Structured event data. Varies per type — see activity/log.ts for the
  // shapes each call site emits.
  payload   Json?
  // User id for human-initiated events. Reserved for the future multi-user
  // model; today everything is system-initiated.
  actorId   String?
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([orgId, createdAt])
  @@index([type, createdAt])
}
