{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "packages": ["apps/*", "packages/*"]
  },
  "entry": [
    "oxlint.config.ts",
    "**/prisma.config.ts",
    "apps/api/src/lib/vitest-setup.ts",
    "apps/api/src/soul/soul.ts"
  ],
  "ignorePatterns": [],
  "ignoreExports": [
    {
      "file": "apps/api/src/middleware/error-handler.ts",
      "exports": ["isPrismaKnownError"]
    }
  ],
  "ignoreDependencies": [
    "pino-pretty",
    "@prisma/client",
    "@vitest/coverage-v8",
    "jsdom"
  ],
  "rules": {
    "unused-dependencies": "warn"
  }
}
