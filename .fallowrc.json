{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "packages": ["apps/*", "packages/*"]
  },
  "entry": [
    "oxlint.config.ts",
    "**/prisma.config.ts",
    "apps/api/src/lib/vitest-setup.ts",
    "apps/api/src/testing/agents-fixture-server.ts",
    "apps/*/src/lib/observability.ts",
    "packages/transactional/src/emails/**/*.tsx",
    "scripts/e2e-*.mjs",
    "tests/e2e/support/*.mjs",
    "apps/agents/flue.config.ts",
    "apps/agents/src/app.ts",
    "apps/agents/src/cloudflare.ts",
    "apps/agents/src/agents/*.ts"
  ],
  "ignorePatterns": [],
  "ignoreExports": [
    {
      "file": "apps/api/src/middleware/error-handler.ts",
      "exports": ["isPrismaKnownError"]
    },
    {
      "file": "apps/web/src/app/not-found.tsx",
      "exports": ["metadata"]
    },
    {
      "file": "apps/backoffice/src/app/not-found.tsx",
      "exports": ["metadata"]
    },
    {
      "file": "apps/landing/src/app/not-found.tsx",
      "exports": ["metadata"]
    }
  ],
  "ignoreDependencies": [
    "@prisma/client",
    "@vitest/coverage-v8",
    "jsdom",
    "better-auth",
    "hono",
    "react",
    "postcss-load-config",
    "agents",
    "valibot"
  ],
  "rules": {
    "unused-dependencies": "warn",
    "private-type-leaks": "off"
  },
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  }
}
