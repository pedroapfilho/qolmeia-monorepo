{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "packages": ["apps/*", "packages/*"]
  },
  "entry": [
    "oxlint.config.ts",
    "apps/auth/src/lib/vitest-setup.ts",
    "apps/*/src/lib/observability.ts",
    "packages/transactional/src/emails/**/*.tsx",
    "scripts/e2e-*.mjs"
  ],
  "ignorePatterns": [],
  "ignoreExports": [],
  "ignoreDependencies": [
    "@vitest/coverage-v8",
    "jsdom",
    "better-auth",
    "hono",
    "react",
    "postcss-load-config"
  ],
  "rules": {
    "unused-dependencies": "warn"
  }
}
